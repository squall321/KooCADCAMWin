# Default: normalize line endings to LF in the repository
* text=auto eol=lf

# Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX scripts use LF
*.sh text eol=lf

# Binary assets — no line-ending conversion
*.step binary
*.stp binary
*.stl binary
*.png binary
*.jpg binary

# Build output directories
build/
build-*/
out/

# IDE directories
.vs/
.vscode/*.user

# CMake user-local presets (should not be committed)
CMakeUserPresets.json

# vcpkg installed packages (generated)
vcpkg_installed/

# MSVC build artifacts
*.user
*.aps
*.pdb
*.ilk
*.exp

# CI test output executables
*.exe.*

# Generated test data (created by CMake custom_command)
tests/data/*.step
tests/data/*.stp

# Editor swap/backup files
*.swp
*.bak

# macOS metadata (should not appear, but guard anyway)
.DS_Store

# Windows thumbnail cache
Thumbs.db

# Temporary clones used while researching upstream samples
_*/

# Allow .gitkeep sentinels
!.gitkeep

# Claude Code session / agent working dir (never commit)
.claude/

# CTest scratch output (created when ctest runs in the source tree)
/Testing/

# Throwaway dev build wrappers + logs (root-level scratch from agent runs)
/build_*.cmd
/build_*.log
/run_*.cmd
/run_*.log
/z_*.log
/*.log
/debug_ninja.cmd
/stderr_dump.txt
/DELETE_REPORT.txt
/all_tests_run.log
/*_commit_msg.txt
